# ---------------------------------------------------------------------------
# PUBLIK (boleh terlihat di browser)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → API → Project URL
NUXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
NUXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# URL HTTPS final aplikasi (dipakai untuk URL API yang disalin & redirect email Auth)
NUXT_PUBLIC_APP_URL=https://daftar-hadiah.example.com

# ---------------------------------------------------------------------------
# SERVER-ONLY (JANGAN pernah diberi prefiks NUXT_PUBLIC_, jangan di-commit)
# ---------------------------------------------------------------------------
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
NUXT_SUPABASE_SECRET_KEY=
# Secret HMAC untuk hash Token Website (min. 32 karakter acak).
# Buat sekali:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Mengganti nilai ini membuat SEMUA Token Website lama tidak valid.
NUXT_TOKEN_HASH_SECRET=
# Batas permintaan plugin per Token Website per menit (default 1200)
NUXT_INTEGRATION_RATE_LIMIT=1200
